# HyperFrames 試算：共用檔的唯一來源是 hyperframes_trial/{shared,vendor}/
# 各專案內的副本由 sync.sh 產生，不進版控（避免四份漂移）
hyperframes_trial/*/shared/
hyperframes_trial/*/vendor/
# vessel-02 的衛星影像來自私人 repo liam-workspace，不進公開庫
hyperframes_trial/*/assets/

# HyperFrames 旁白音檔：一律不進公開 repo
# 克隆聲音是生物特徵資料（2026-09-10 Lien 明確歸類為個資敏感），
# 與影像素材同一個判斷——公開庫不含二進位素材。
# 音檔在私人 repo liam-workspace/assets/voice/hyperframes/，
# 渲染時與影像素材同一個 checkout 步驟取回。
hyperframes_trial/*/audio/
# 渲染與檢查的中間產物
hyperframes_trial/*/snapshots/
hyperframes_trial/*/doctor.json
hyperframes_trial/*/audio_edgetts_備份_*/

# 遮擋工具的衍生檔（render 會重新產生）
dessert/遮擋/*.cmd
dessert/遮擋/*_sticker.png
dessert/遮擋/*.proxy.mp4
dessert/遮擋/*_check.jpg

# 提案影片（proposal_video/）：同 hyperframes_trial 的判斷
# 旁白是 Lien 的克隆聲音＝生物特徵資料，一律不進公開 repo。
# 正本在 proposal_video/audio/，備份走私人 repo liam-workspace/assets/voice/proposal/
proposal_video/audio/
proposal_video/*/audio/
# 共用檔的唯一來源是 proposal_video/{shared,vendor}/，各專案內的副本由 build.py 產生
proposal_video/*/shared/
proposal_video/*/vendor/
proposal_video/*/snapshots/
proposal_video/*/doctor.json
proposal_video/*/renders/
proposal_video/*/shots/
proposal_video/*.備份_*
